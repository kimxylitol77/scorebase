# 맥미니 이전 감시봇 (2026-08-08) — 원본 launchd com.scorebase.uncovered-leagues (oneshot)
[Unit]
Description=Scorebase Bot: uncovered-leagues (migrated from mac mini)
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-bots/mac-mini-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-bots/mac-mini-worker/uncovered-leagues.js
StandardOutput=append:/home/ubuntu/scorebase-bots/logs/uncovered-leagues.log
StandardError=append:/home/ubuntu/scorebase-bots/logs/uncovered-leagues.log
