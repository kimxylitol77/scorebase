# 맥미니 이전 감시봇 (2026-08-08) — 원본 launchd com.scorebase.event-radar (oneshot)
[Unit]
Description=Scorebase Bot: event-radar (migrated from mac mini)
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-bots/mac-mini-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-bots/mac-mini-worker/event-radar.js
StandardOutput=append:/home/ubuntu/scorebase-bots/logs/event-radar.log
StandardError=append:/home/ubuntu/scorebase-bots/logs/event-radar.log
