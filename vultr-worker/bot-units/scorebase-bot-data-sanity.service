# 맥미니 이전 감시봇 (2026-08-08) — 원본 launchd com.scorebase.data-sanity
[Unit]
Description=Scorebase Bot: data-sanity (migrated from mac mini)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-bots/mac-mini-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-bots/mac-mini-worker/data-sanity.js
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/scorebase-bots/logs/data-sanity.log
StandardError=append:/home/ubuntu/scorebase-bots/logs/data-sanity.log

[Install]
WantedBy=multi-user.target
