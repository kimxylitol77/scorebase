# 맥미니 이전 감시봇 (2026-08-08) — 원본 launchd com.scorebase.stale-ts-verify
[Unit]
Description=Scorebase Bot: stale-ts-verify (migrated from mac mini)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-bots/mac-mini-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-bots/mac-mini-worker/stale-ts-verify.js
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/scorebase-bots/logs/stale-ts-verify.log
StandardError=append:/home/ubuntu/scorebase-bots/logs/stale-ts-verify.log

[Install]
WantedBy=multi-user.target
