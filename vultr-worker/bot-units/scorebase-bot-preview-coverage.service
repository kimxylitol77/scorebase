# 맥미니 이전 감시봇 (2026-08-08) — 원본 launchd com.scorebase.preview-coverage
[Unit]
Description=Scorebase Bot: preview-coverage (migrated from mac mini)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-bots/mac-mini-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-bots/mac-mini-worker/preview-coverage.js
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/scorebase-bots/logs/preview-coverage.log
StandardError=append:/home/ubuntu/scorebase-bots/logs/preview-coverage.log

[Install]
WantedBy=multi-user.target
