# 맥미니 이전 감시봇 (2026-08-08) — 원본 launchd com.scorebase.live-scores-watcher
[Unit]
Description=Scorebase Bot: live-scores-watcher (migrated from mac mini)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-bots/mac-mini-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-bots/mac-mini-worker/live-scores-watcher.js
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/scorebase-bots/logs/live-scores-watcher.log
StandardError=append:/home/ubuntu/scorebase-bots/logs/live-scores-watcher.log

[Install]
WantedBy=multi-user.target
