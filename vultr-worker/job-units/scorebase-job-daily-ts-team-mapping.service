# 맥미니 이전 repo 잡 (2026-09-03) — 원본 launchd com.scorebase.daily-ts-team-mapping
[Unit]
Description=Scorebase Job: daily-ts-team-mapping (migrated from mac mini)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase
ExecStart=/bin/zsh /home/ubuntu/scorebase/mac-mini-worker/daily-ts-team-mapping.sh
StandardOutput=append:/home/ubuntu/scorebase/logs/daily-ts-team-mapping.log
StandardError=append:/home/ubuntu/scorebase/logs/daily-ts-team-mapping.log
TimeoutStartSec=3600
