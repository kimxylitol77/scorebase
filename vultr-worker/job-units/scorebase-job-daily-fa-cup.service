# 맥미니 이전 repo 잡 (2026-09-03) — 원본 launchd com.scorebase.daily-fa-cup
[Unit]
Description=Scorebase Job: daily-fa-cup (migrated from mac mini)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase
ExecStart=/bin/zsh /home/ubuntu/scorebase/mac-mini-worker/daily-fa-cup.sh
StandardOutput=append:/home/ubuntu/scorebase/logs/daily-fa-cup.log
StandardError=append:/home/ubuntu/scorebase/logs/daily-fa-cup.log
TimeoutStartSec=3600
