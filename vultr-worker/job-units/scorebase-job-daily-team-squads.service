# 맥미니 이전 repo 잡 (2026-09-03) — 원본 launchd com.scorebase.daily-team-squads
[Unit]
Description=Scorebase Job: daily-team-squads (migrated from mac mini)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase
ExecStart=/bin/zsh /home/ubuntu/scorebase/mac-mini-worker/daily-team-squads.sh
StandardOutput=append:/home/ubuntu/scorebase/logs/daily-team-squads.log
StandardError=append:/home/ubuntu/scorebase/logs/daily-team-squads.log
TimeoutStartSec=3600
