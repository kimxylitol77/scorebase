# 맥미니 이전 repo 잡 (2026-09-03) — 원본 launchd com.scorebase.weekly-static-refresh
[Unit]
Description=Scorebase Job: weekly-static-refresh (migrated from mac mini)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase
ExecStart=/bin/zsh /home/ubuntu/scorebase/mac-mini-worker/weekly-static-refresh.sh
StandardOutput=append:/home/ubuntu/scorebase/logs/weekly-static-refresh.log
StandardError=append:/home/ubuntu/scorebase/logs/weekly-static-refresh.log
TimeoutStartSec=3600
