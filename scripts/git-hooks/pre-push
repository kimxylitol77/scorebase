#!/usr/bin/env bash
# 푸시 시점 게이트 — main 으로 올라가는 커밋은 tsc + 단위 테스트를 통과한 트리여야 한다 (Vercel 이 곧 배포하므로)
set -u
cd "$(git rev-parse --show-toplevel)"
gate="$(git rev-parse --git-common-dir)/gate-ok"

# pre-commit 에서 검증 표시가 남은 트리는 다시 검사하지 않는다
need=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  tree=$(git rev-parse "$local_sha^{tree}" 2>/dev/null) || { need=1; continue; }
  [ -f "$gate/$tree" ] || need=1
done
[ "$need" = 0 ] && exit 0

# 워크트리에는 node_modules 가 없다 — 공용 .git 의 부모(저장소 루트)에서도 찾는다.
repo_root=$(dirname "$(git rev-parse --git-common-dir)")
if [ ! -x node_modules/.bin/tsc ] && [ ! -x "$repo_root/node_modules/.bin/tsc" ]; then
  echo "[pre-push] node_modules 가 없어 검증 없이 푸시합니다. 메인 저장소에서 npm run typecheck && npm test 를 확인하세요." >&2
  exit 0
fi

if ! out=$(npm run -s typecheck 2>&1); then
  echo "[pre-push] tsc 실패 — 푸시할 수 없습니다." >&2
  echo "$out" | tail -30 >&2
  exit 1
fi
if ! out=$(npm test -s 2>&1); then
  echo "[pre-push] 테스트 실패 — 푸시할 수 없습니다. 테스트를 고치지 말고 코드를 고치세요." >&2
  echo "$out" | grep -vE '^✔' | tail -40 >&2
  exit 1
fi
mkdir -p "$gate"
touch "$gate/$(git rev-parse 'HEAD^{tree}')"
exit 0
