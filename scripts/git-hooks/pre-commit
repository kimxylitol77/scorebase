#!/usr/bin/env bash
# 커밋 시점 게이트 — 임시 스크립트 유입·스키마 변경 SQL 누락·타입/테스트 실패를 커밋 전에 차단한다
set -u
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. 일회성 scratch 파일(기본 이름이 _ 로 시작하는 코드 파일)은 새로 추가할 수 없다
list_scratch() {
  git diff --cached --name-only --diff-filter=A | while read -r f; do
    b=$(basename "$f")
    case "$b" in
      (__*) ;;
      (_*.ts|_*.tsx|_*.mts|_*.mjs|_*.js|_*.py|_*.sh) echo "$f" ;;
    esac
  done
}
if [ -z "${SKIP_SCRATCH_GUARD:-}" ]; then
  scratch=$(list_scratch)
  if [ -n "$scratch" ]; then
    echo "[pre-commit] 일회성 scratch 파일이 스테이징돼 있습니다. 커밋 대상이 아닙니다." >&2
    echo "$scratch" | sed 's/^/  /' >&2
    echo "  해제: git restore --staged <파일>   정말 필요하면: SKIP_SCRATCH_GUARD=1 git commit ..." >&2
    exit 1
  fi
fi

# 2. prisma/schema.prisma 를 바꾸면 Neon 에서 실행할 SQL 을 prisma/sql/ 에 같이 남긴다
if [ -z "${SKIP_SCHEMA_SQL:-}" ] && echo "$staged" | grep -qx 'prisma/schema.prisma'; then
  if ! echo "$staged" | grep -q '^prisma/sql/.*\.sql$'; then
    echo "[pre-commit] schema.prisma 가 바뀌었는데 prisma/sql/*.sql 이 함께 스테이징되지 않았습니다." >&2
    echo "  프로덕션은 db push 대신 SQL 직접 실행이므로 ALTER 문을 prisma/sql/$(date +%Y%m%d)-<설명>.sql 로 남기고 같이 커밋하세요." >&2
    echo "  DB 에 영향 없는 변경이면: SKIP_SCHEMA_SQL=1 git commit ..." >&2
    exit 1
  fi
fi

# 3. 코드가 바뀌었으면 tsc + 단위 테스트 통과가 커밋의 조건이다
if echo "$staged" | grep -qE '\.(ts|tsx|mts)$'; then
  if [ ! -x node_modules/.bin/tsc ]; then
    echo "[pre-commit] node_modules 가 없어 tsc·테스트를 건너뜁니다 (push 시 다시 검사)." >&2
  else
    if ! out=$(npm run -s typecheck 2>&1); then
      echo "[pre-commit] tsc 실패 — 커밋할 수 없습니다." >&2
      echo "$out" | tail -30 >&2
      exit 1
    fi
    if ! out=$(npm test -s 2>&1); then
      echo "[pre-commit] 테스트 실패 — 커밋할 수 없습니다. 테스트를 고치지 말고 코드를 고치세요." >&2
      echo "$out" | grep -vE '^✔' | tail -40 >&2
      exit 1
    fi
    mkdir -p "$(git rev-parse --git-common-dir)/gate-ok"
    touch "$(git rev-parse --git-common-dir)/gate-ok/$(git write-tree)"
  fi
fi

exit 0
