// ====================================================
// Scorebase DB Schema
// 운영: PostgreSQL (Neon)
// ====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 팀 정보
model Team {
  id         Int      @id @default(autoincrement())
  league     String // KBO | EPL | NBA
  externalId String // 외부 API 의 팀 ID
  name       String
  shortName  String?
  logoUrl    String?
  createdAt  DateTime @default(now())

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  @@unique([league, externalId])
}

// 경기 정보
model Match {
  id         Int      @id @default(autoincrement())
  league     String // KBO | EPL | NBA
  externalId String // 외부 API 의 경기 ID
  homeTeamId Int
  awayTeamId Int
  homeScore  Int?
  awayScore  Int?
  status     String // SCHEDULED | LIVE | FINISHED | POSTPONED
  startTime  DateTime
  raw        String? // 원본 JSON (디버깅/재가공용)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 적중률 백테스트 — 매치 시점 기준 추정 (PREVIEW 글 유무와 무관하게 모든 매치 대상)
  predHome   Float?
  predDraw   Float?
  predAway   Float?
  predWinner String? // "HOME" | "DRAW" | "AWAY"
  predCorrect Boolean? // 매치 종료 후 actual 과 일치 여부

  homeTeam Team      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  articles Article[]

  @@unique([league, externalId])
  @@index([league, startTime])
  @@index([status])
  @@index([league, predCorrect])
}

// 페이지뷰 트래킹 — 단순 카운트 + 시간대별 그래프용
model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  ts        DateTime @default(now())
  userAgent String?
  referrer  String?

  @@index([ts])
  @@index([path])
}

// AI 가 생성한 기사
model Article {
  id          Int       @id @default(autoincrement())
  matchId     Int?
  type        String // PREVIEW | RECAP | ANALYSIS
  league      String
  title       String
  slug        String    @unique
  content     String // Markdown
  status      String // DRAFT | PENDING_REVIEW | APPROVED | PUBLISHED | REJECTED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // PREVIEW 한정: 글 작성 시점에 추정한 승률 + 가장 높은 확률의 결과
  // (적중률 통계용 — match 종료 후 evaluate 잡이 actualWinner/correct 채움)
  predHome    Float?    // 0~1
  predDraw    Float?    // 0~1
  predAway    Float?    // 0~1
  predWinner  String?   // "HOME" | "DRAW" | "AWAY"
  evaluatedAt DateTime?
  correct     Boolean?  // null = 미평가, true/false = 평가됨

  match Match? @relation(fields: [matchId], references: [id])

  @@index([league, status])
  @@index([publishedAt])
  @@index([type, evaluatedAt])
}
