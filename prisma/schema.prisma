// ====================================================
// Scorebase DB Schema
// 운영: PostgreSQL (Neon)
// ====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 팀 정보
model Team {
  id         Int      @id @default(autoincrement())
  league     String // KBO | EPL | NBA | NHL | MLB | LALIGA | BUNDESLIGA | SERIE_A | LIGUE_1 | MLS | UCL | WORLD_CUP
  externalId String // 외부 API 의 팀 ID
  name       String
  shortName  String?
  logoUrl    String?

  // 예측 시스템 — Elo 레이팅 (FiveThirtyEight 방식, 신규 팀 1500 시드)
  eloRating  Float   @default(1500)

  // 메타 정보 (cron 으로 점진 백필 — 모두 nullable)
  country    String?  // "England" | "South Korea" | "United States" ...
  city       String?  // "Manchester" | "Seoul" | "New York"
  venue      String?  // 홈 구장 이름 (예: "Old Trafford")
  founded    Int?     // 창단 연도
  coach      String?  // 현 감독/매니저 이름

  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  sourceIds   TeamSourceId[]

  @@unique([league, externalId])
  @@index([league, eloRating])
}

/// 외부 source 별 팀 ID 매핑. (league, source, externalId) → canonical Team.id.
/// 같은 팀이 source 별로 다른 ext id 를 가질 때 row 양산을 막기 위해 도입 (2026-05-25).
/// source 값: 'thesports' | 'api-football' | 'espn' | 'balldontlie'
///          | 'api-sports' | 'football-data' | 'kbo' | 'npb' | 'legacy'
model TeamSourceId {
  id         Int      @id @default(autoincrement())
  league     String
  source     String
  externalId String
  teamId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([league, source, externalId])
  @@index([teamId])
  @@index([league, source])
}

// 경기 정보
model Match {
  id         Int      @id @default(autoincrement())
  league     String // KBO | EPL | NBA
  externalId String // 외부 API 의 경기 ID
  homeTeamId Int
  awayTeamId Int
  homeScore  Int?
  awayScore  Int?
  status     String // SCHEDULED | LIVE | FINISHED | POSTPONED
  startTime  DateTime
  raw        String? // 원본 JSON (디버깅/재가공용)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 적중률 백테스트 — 매치 시점 기준 추정 (PREVIEW 글 유무와 무관하게 모든 매치 대상)
  // 1X2 (Money Line / 1X2)
  predHome   Float?
  predDraw   Float?
  predAway   Float?
  predWinner String? // "HOME" | "DRAW" | "AWAY"
  predCorrect Boolean? // 매치 종료 후 actual 과 일치 여부

  // Double Chance (축구 전용 — 무승부 흡수형 시장)
  predDcPick    String?  // "1X" | "X2" | "12"
  predDcProb    Float?
  predDcCorrect Boolean?

  // OVER/UNDER 2.5 골 (축구 전용 — Poisson 모델 기반)
  predOverProb    Float?  // OVER 2.5 확률
  predOverPick    String? // "OVER" | "UNDER"
  predOverCorrect Boolean?

  // BTTS (Both Teams To Score, 축구 전용)
  predBttsProb    Float?
  predBttsPick    String? // "YES" | "NO"
  predBttsCorrect Boolean?

  // 핸디캡 (Asian Handicap / Spread) — 종목별 line 다름
  // 축구 -0.5 / NBA -5.5 / NHL -1.5 / MLB -1.5
  predHcLine     Float?
  predHcPick     String?  // "HOME" | "AWAY" — 핸디캡 받는 쪽
  predHcProb     Float?
  predHcCorrect  Boolean?

  // The Odds API 시장 odds (1X2, vig 제거된 implied probability)
  marketHome      Float?
  marketDraw      Float?
  marketAway      Float?
  marketUpdatedAt DateTime?
  marketBookmakers Int?  // odds 통합한 bookmaker 수
  // 오프닝 odds — odds cron 이 매치 첫 fetch 시 한 번만 저장. 라인 움직임 추적용.
  openingMarketHome Float?
  openingMarketDraw Float?
  openingMarketAway Float?
  openingCapturedAt DateTime?
  // Value Bet — 우리 모델 prob > 시장 prob + 5%p
  valueGap        Float?  // model_pred - market_pred (양수 = 모델이 시장보다 자신감 큼)
  isValueBet      Boolean? // 5%p 이상 차이 + 모델 pick 와 같은 outcome

  // Raw decimal odds (베팅사이트 평균, vig 미제거 — 표시용)
  oddsHome        Float?  // 1X2 home 배당
  oddsDraw        Float?  // 1X2 draw
  oddsAway        Float?  // 1X2 away
  oddsTotalLine   Float?  // OVER/UNDER 기준선 (예: 2.5)
  oddsOver        Float?  // OVER 배당
  oddsUnder       Float?  // UNDER 배당
  oddsHcLine      Float?  // 시장 핸디캡 line (강팀 -line)
  oddsHcHome      Float?  // 핸디캡 home 배당
  oddsHcAway      Float?  // 핸디캡 away 배당
  oddsBttsYes     Float?  // BTTS YES 배당 (축구)
  oddsBttsNo      Float?  // BTTS NO 배당
  oddsDc1X        Float?  // 더블 찬스 홈승 OR 무
  oddsDc12        Float?  // 더블 찬스 홈승 OR 원정승 (무 제외)
  oddsDcX2        Float?  // 더블 찬스 무 OR 원정승

  // API-Football Pro 통합 (축구만)
  apiFixtureId    Int?     // api-football fixture ID — 한 번 매칭 후 재사용
  lineupHome      String?  // 라인업 JSON (formation, startXI, coach)
  lineupAway      String?
  lineupUpdatedAt DateTime?
  fixtureStats    String?  // 슛/패스/점유율 등 JSON ([{teamId, ...}, ...])
  // API-Football 자체 예측 (third opinion)
  apiPredHome     Float?
  apiPredDraw     Float?
  apiPredAway     Float?
  apiPredWinner   String?  // "HOME" | "DRAW" | "AWAY"
  apiPredAdvice   String?  // raw advice text (예: "Combo : Tottenham or draw and -2.5 goals")
  apiPredCorrect  Boolean?

  // MLB Stats API — 선발 투수 (MLB 만, 매치 직전 publish)
  // 한 줄 JSON 으로 저장 — { name, pid, era, whip, k9, wins, losses, gs, ip, hand }
  homeStarter        String?
  awayStarter        String?
  startersUpdatedAt  DateTime?

  // NHL 공식 API — 시작 골리 (NHL 만)
  // JSON: { pid, name, gaa, savePctg, wins, losses, otLosses, gamesPlayed, shutouts }
  homeGoalie         String?
  awayGoalie         String?
  goaliesUpdatedAt   DateTime?

  // 플레이오프 라운드 메타 (NBA — TheSports stage 라벨). 브라켓 그룹화 키.
  // round: FIRST_ROUND | CONF_SEMIS | CONF_FINALS | FINALS, conference: EAST | WEST | null
  playoffRound       String?
  playoffConference  String?
  playoffStageId     String?  // TheSports stage_id (시리즈 그룹 안정 키)

  homeTeam Team      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  articles Article[]
  theSportsCache TheSportsMatchCache?
  oddsSnapshots  OddsSnapshot[]
  tsBaseballOdds TsBaseballOddsHistory[]
  liveCommentary LiveCommentary?

  @@unique([league, externalId])
  @@index([league, startTime])
  @@index([status])
  @@index([league, predCorrect])
}

// 페이지뷰 트래킹 — 단순 카운트 + 시간대별 그래프용
model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  ts        DateTime @default(now())
  userAgent String?
  referrer  String?
  /// localStorage 발급 random ID — unique 방문자 (사람) 카운트 용. 2026-05-23 추가.
  /// 기존 row 는 null. 새 PV 부터 채워짐.
  sessionId String?

  @@index([ts])
  @@index([path])
  @@index([sessionId])
}

// 공지사항 / 패치노트 / 메인터넌스 안내
model Notice {
  id          Int      @id @default(autoincrement())
  type        String   // "CHANGELOG" | "NOTICE" | "MAINTENANCE"
  title       String
  slug        String   @unique
  content     String // Markdown
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, publishedAt])
}

// SEO 키워드 타깃 블로그 글 (사용자 직접 작성)
model Blog {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  excerpt      String?  // meta description / 목록 한 줄 소개
  content      String   // Markdown 본문
  tags         String?  // 쉼표 구분 키워드 (SEO meta keywords)
  thumbnailUrl String?  // OG image / 목록 썸네일
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
}

// AI 가 생성한 기사
model Article {
  id          Int       @id @default(autoincrement())
  matchId     Int?
  type        String // PREVIEW | RECAP | ANALYSIS
  league      String
  title       String
  slug        String    @unique
  content     String // Markdown
  status      String // DRAFT | PENDING_REVIEW | APPROVED | PUBLISHED | REJECTED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // PREVIEW 한정: 글 작성 시점에 추정한 승률 + 가장 높은 확률의 결과
  // (적중률 통계용 — match 종료 후 evaluate 잡이 actualWinner/correct 채움)
  predHome    Float?    // 0~1
  predDraw    Float?    // 0~1
  predAway    Float?    // 0~1
  predWinner  String?   // "HOME" | "DRAW" | "AWAY"
  evaluatedAt DateTime?
  correct     Boolean?  // null = 미평가, true/false = 평가됨

  // LoL RECAP 전용 — 게임별 MVP/LVP·타임라인·시즌·다음 매치·Quote 카드 데이터.
  // 페이지에서 JSON.parse 후 카드 컴포넌트에 prop 으로 전달.
  lolContext  String?   // JSON serialized LolRecapContext

  // 야구(KBO/MLB/NPB) PREVIEW/RECAP — 이닝별 득점 확률 + 총 예상 득점 + 모델
  // 승률 (Poisson + Skellam). 페이지에서 JSON.parse 후 InningScoreChart 렌더.
  baseballContext String? // JSON: { inningScoreProbs, totalExpectedRuns, winProbPoisson }

  match Match? @relation(fields: [matchId], references: [id])

  @@index([league, status])
  @@index([publishedAt])
  @@index([type, evaluatedAt])
}

// 시즌 리그 리더보드 — 득점·도움·카드 (축구), PTS·AST·REB (NBA),
// ERA·홈런·타율 (야구) 등. cron 이 매일 fetch 해서 upsert.
model LeagueLeader {
  id           Int      @id @default(autoincrement())
  league       String   // EPL · LALIGA · NBA · KBO · NPB · MLB · NHL · LOL ...
  category     String   // GOAL · ASSIST · YELLOW · RED · PTS · AST · REB · ERA · BA · HR · K · SAVE · KDA · CS ...
  rank         Int      // 1 시작
  playerName   String   // 표시용 (한글 변환 시도)
  playerNameEn String?  // 원문 (영문)
  externalId   String?  // 외부 API 의 player id (선수 페이지 link 용)
  teamName     String   // 표시용
  teamShort    String?
  value        Float    // 골수 · 도움 · 카드 · ERA · 타율 등
  unit         String?  // "득점" · "도움" · "ERA" 등 짧은 라벨 (UI 표시용)
  appearances  Int?     // 출장수 (축구) / 경기수 (야구 등)
  photoUrl     String?  // 선수 사진 (외부 API 제공 시)
  season       String   // "2025-26" (축구) · "2026" (야구 등)
  fetchedAt    DateTime @default(now())

  @@unique([league, category, rank, season])
  @@index([league, season])
  @@index([league, category])
}

// TheSports.com football match cache — Lightsail worker 가 1분 주기 fetch.
// detail_live (stats·incidents·tlive), lineup/detail (formation·선수 list), analysis (h2h·goal_distribution) 셋을 JSON 으로 저장.
model TheSportsMatchCache {
  id          Int      @id @default(autoincrement())
  matchId     Int      @unique
  tsMatchId   String
  detailLive  Json?
  lineup      Json?
  analysis    Json?
  /// Match team statistics — /v1/football/match/team_stats/list 의 stats[] (home + away named fields).
  /// 2026-05-20 추가, worker v3 1분 주기 push.
  teamStats   Json?
  /// Match player statistics — /v1/football/match/player_stats/list 의 player_stats[].
  /// 선수별 boxscore (goals/shots/passes/...).
  playerStats Json?
  /// Match team half-time statistics — /v1/football/match/half/team_stats/list 응답.
  /// 구조: { p1: { stat_type_id: [home, away] }, p2: { ... } }
  /// 전반 점수 (p1 의 goals stat_type_id) + 전반 슛/점유 등 표시 용도.
  /// 2026-05-21 추가, worker v3+ 1분 주기 push.
  halfTeamStats Json?
  /// Match momentum trend — /v1/football/match/trend/detail 응답.
  /// 구조: { count, per, data: [[전반 분당 값], [후반 분당 값]] }
  /// 값 -100~+100 (home 양수, away 음수, 1분 단위 momentum).
  /// 2026-05-25 추가, Lightsail football-poller v3+ 5분 cycle 갱신.
  trend       Json?
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([tsMatchId])
}

/// TheSports season/recent/table/detail 응답을 league별로 캐싱.
/// Lightsail worker 가 1시간 주기로 POST /api/internal/thesports-standings 로 갱신.
/// Vercel serverless IP 가 ts whitelist 미포함이라 page server-side fetch 불가 → DB 우회.
model TheSportsStandingsCache {
  league      String   @id              // 우리 league code (EPL, LALIGA, ...)
  tsSeasonId  String                    // ts season uuid
  payload     Json                      // {promotions, tables} — TSFootballSeasonStandingsResponse.results
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// api-football /standings 응답을 normalized 저장.
/// row.teamExternalId = api-football team id = 우리 Team.externalId (api-football 기반 리그).
/// 매핑 dictionary 없이 바로 Team.externalId 로 join 가능 — TheSports mapping 누락 회피.
model ApiFootballStandingsCache {
  league    String   @id
  season    Int
  rows      Json     @default("[]") // [{teamExternalId, position, points, won, draw, loss, group?}, ...]
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 외부 워커 (Mac mini, Lightsail 등) 의 heartbeat. 워커가 5분마다 POST.
/// Vercel cron 이 매 10분 lastAt 체크 — 30분+ 무응답 시 텔레그램 알림.
/// 다중 워커 식별 위해 name 을 PK 로 사용 (ex: "mac-mini-match-narrator").
model BotHeartbeat {
  name       String    @id              // 워커 식별자
  lastAt     DateTime  @default(now())  // 마지막 ping
  metadata   Json?                      // 호스트명, 버전, 부가 정보
  notifiedAt DateTime?                  // 마지막 down 알림 발송 시각 (중복 알림 방지)
  createdAt  DateTime  @default(now())

  @@index([lastAt])
}

/// Ollama (Mac mini, Qwen 2.5 14B) 가 생성한 라이브 매치 코멘터리 캐시.
/// 후보 1 — eventComments: 이벤트별 1줄 자연어 (JSON 배열).
/// 후보 2 — matchSummary: 매치 진행 상황 박스 (3-4문장, ~5분 주기 갱신).
/// 매치당 1 row, Mac mini worker 가 POST /api/internal/live-commentary 로 upsert.
model LiveCommentary {
  matchId       Int      @id
  league        String                              // index — 리그별 dashboard 필터
  /// 이벤트별 1줄 (JSON array): [{key, comment, at}, ...]
  /// key = 이벤트 고유 해시 (예: "goal-78-rashford-home")
  eventComments Json?
  /// 매치 진행 상황 박스 (3-4문장)
  matchSummary  String?
  /// 매치 요약 마지막 생성 시각 — stale 판단용
  summaryAt     DateTime?
  /// 마지막 요약 생성 시점 컨텍스트 ("2:1 78'" 등) — UI 표시 + stale 판단용
  scoreSnapshot String?
  /// 생성 모델 (변경 시 추적). ex) "ollama-qwen2.5-14b" / "claude-sonnet-4-5"
  model         String   @default("ollama-qwen2.5-14b")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([league, updatedAt])
}

/// 데일리 health-check 봇 결과. 매일 06:30 KST cron 이 약 15개 체크 함수 실행 → row insert.
/// severity HIGH 발견 시 텔레그램 알림. /admin/health 페이지에서 시각화.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  runAt     DateTime @default(now())          // 체크 실행 시각
  severity  String                              // "HIGH" | "MED" | "LOW" | "OK"
  category  String                              // 체크 카테고리 (season-label · match-count · accuracy 등)
  key       String                              // 세부 키 (예: "NHL" / "MLB" / "EPL")
  message   String                              // 사람이 읽을 메시지 (예: "NHL 리더보드 시즌 = 2026-27 (미래 시즌)")
  metadata  Json?                               // 자유 데이터 (실제 값 · 기대 값 · 카운트 등)

  @@index([runAt])
  @@index([severity, runAt])
  @@index([category, runAt])
}

/// 라이브 배당 시계열 — The Odds API h2h (1X2) 평균 odds snapshot.
/// /api/live/* route 가 fetchLiveOdds 후 자동 upsert (1분 1 row, 같은 분 중복 skip).
/// 사용처: 매치 디테일 페이지 sparkline + /value-bets 페이지 + line movement 분석.
model OddsSnapshot {
  id          Int      @id @default(autoincrement())
  matchId     Int                                  // 우리 Match.id
  fetchedAt   DateTime @default(now())             // snapshot 시각 (분 단위 unique)
  homeOdds    Float                                // h2h home decimal odds (평균)
  drawOdds    Float?                               // h2h draw (축구만, 야구/농구는 null)
  awayOdds    Float
  bookmakers  Int                                  // 평균에 들어간 북메이커 수
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, fetchedAt])
  @@index([fetchedAt])
}

/// TheSports baseball odds history — `/v1/baseball/odds/history` 응답의 시계열 row.
/// kind = "eu" (머니라인), "asia" (런라인/핸디캡), "bs" (오버언더).
/// row 구조: [ts, v1, mid, v2, status] — eu: (home, draw=0, away), asia: (home, line, away), bs: (over, line, under).
/// Lightsail worker (baseball-odds-poller) 가 60초 cycle 로 fetch → /api/internal/save-baseball-odds upsert.
/// 페이지 SSR 이 (matchId, kind="eu", companyId="2") 최근 30~50 row → sparkline.
model TsBaseballOddsHistory {
  id        BigInt   @id @default(autoincrement())
  matchId   Int
  companyId String           // 예: "2" (Bet365). source 분리 위해 raw 보존.
  kind      String           // "eu" | "asia" | "bs"
  ts        Int              // unix sec — TheSports 응답의 첫 컬럼
  v1        Float            // eu: home / asia: home / bs: over
  mid       Float?           // eu: draw (야구는 0) / asia: handicap line / bs: total line
  v2        Float            // eu: away / asia: away / bs: under
  status    Int      @default(0)
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, companyId, kind, ts])
  @@index([matchId, kind, ts])
  @@index([matchId, ts])
}

/// TheSports player dictionary — 야구 (KBO/NPB/MLB) 박스스코어 선수 이름 매핑.
/// detail_live.players[].id (해시) → name / nameKo 변환을 위한 캐시.
/// Lightsail worker (ts-baseball-players-cron) 가 매일 1회 team 별 player/list iterate 후 upsert.
/// nameKo 는 적재 시점에 toKoreanPlayerName 으로 한 번 계산 (dictionary 매칭 안 되면 영문).
model TheSportsPlayer {
  id        String   @id              // ts player id (해시)
  name      String                    // 영문 풀네임 (ts player.name)
  nameKo    String?                   // toKoreanPlayerName 결과, dictionary miss 시 null
  shortName String?                   // ts player.short_name (lastname only 일 때 많음)
  teamId    String?                   // ts team_id — 팀 변경 시 갱신
  sport     String                    // "KBO" | "NPB" | "MLB"
  position  String?                   // ts position (P/C/1B/...)
  /** 선수 사진 URL. KBO: KBO_IMAGE/person/middle/{year}/{P_ID}.jpg, NPB: npb.jp/players_photo, MLB: mlbstatic headshot */
  photoUrl  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([sport, teamId])
}
