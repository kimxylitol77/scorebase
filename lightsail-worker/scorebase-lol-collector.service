[Unit]
Description=Scorebase LOL (LCK) match collector — TheSports lol/match/tournament → /api/internal/lol-matches
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/lol-collector.js
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/lol-collector.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/lol-collector.err
