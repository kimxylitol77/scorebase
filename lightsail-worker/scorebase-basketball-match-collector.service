[Unit]
Description=Scorebase TheSports Basketball Match Collector (30min diary sweep, NBA/WNBA/KBL/WKBL)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/basketball-match-collector.js
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/basketball-match-collector.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/basketball-match-collector.err

[Install]
WantedBy=multi-user.target
