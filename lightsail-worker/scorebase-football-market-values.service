[Unit]
Description=Scorebase Football Market Values — TheSports player/market/list 증분 → API push
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/football-market-values-cron.js
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/football-market-values.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/football-market-values.err
