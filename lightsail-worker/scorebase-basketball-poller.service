[Unit]
Description=Scorebase TheSports Basketball Poller (1min detail_live, NBA/WNBA/KBL/WKBL)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/basketball-poller.js
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/basketball-poller.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/basketball-poller.err

[Install]
WantedBy=multi-user.target
