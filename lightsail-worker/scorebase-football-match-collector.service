[Unit]
Description=Scorebase TheSports Football Match Collector (1h diary sweep)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/football-match-collector.js
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/football-match-collector.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/football-match-collector.err

[Install]
WantedBy=multi-user.target
