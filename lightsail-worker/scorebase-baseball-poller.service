[Unit]
Description=Scorebase TheSports Baseball Detail Live Poller
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/baseball-poller.js
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/baseball-poller.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/baseball-poller.err

[Install]
WantedBy=multi-user.target
