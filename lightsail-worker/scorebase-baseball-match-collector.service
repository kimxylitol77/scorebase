[Unit]
Description=Scorebase TheSports Baseball Match Collector (30min diary sweep, KBO/NPB/MLB)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/baseball-match-collector.js
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/baseball-match-collector.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/baseball-match-collector.err

[Install]
WantedBy=multi-user.target
