[Unit]
Description=Scorebase KBO Player Names — TheSports player/list + Anthropic 음역 + DB upsert
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/kbo-player-names-cron.js
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/kbo-player-names.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/kbo-player-names.err
