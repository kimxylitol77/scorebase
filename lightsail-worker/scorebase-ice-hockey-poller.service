[Unit]
Description=Scorebase TheSports Ice Hockey Poller (1min detail_live, NHL)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/scorebase-worker
ExecStart=/usr/bin/node /home/ubuntu/scorebase-worker/src/ice-hockey-poller.js
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/scorebase-worker/logs/ice-hockey-poller.log
StandardError=append:/home/ubuntu/scorebase-worker/logs/ice-hockey-poller.err

[Install]
WantedBy=multi-user.target
