<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scorebase.ai-company-server</string>
    <key>WorkingDirectory</key>
    <string>/Users/kkulkkul/dev/scorebase/ai-company</string>
    <!-- 회의 기록 REST 조회용 FastAPI (GET /sessions, /agents). 유휴 시 모델 미로드라 가벼움 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kkulkkul/dev/scorebase/ai-company/venv/bin/python</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>server.main:app</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8000</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/ai-company-server.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ai-company-server.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
