# scorebase Vercel env 와 동일 값. /admin 또는 vercel env pull 로 확인.
INTERNAL_API_TOKEN=

# 사이트 URL (기본값 production)
SITE_URL=https://www.scorebase.kr

# Ollama 호스트 (Mac mini 로컬)
OLLAMA_HOST=http://localhost:11434

# 모델명 (기본 qwen2.5:14b)
OLLAMA_MODEL=qwen2.5:14b

# 대상 리그 — 콤마 구분. 기본 야구 3리그.
LEAGUES=KBO,NPB,MLB

# Instagram Threads 자동 포스팅 (threads-auto-poster.js) — docs/threads-setup.md 절차로 발급.
# 최초 1회만 .env 에 넣으면 이후 threads-token.json 이 자동 refresh(60일 무한 연장).
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# 발행 대신 caption/이미지 URL 만 로그로 출력하는 테스트 모드(=1).
THREADS_DRY_RUN=
