{
  "name": "scorebase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/build-pages-inventory.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/build-pages-inventory.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "job:collect": "tsx src/jobs/collect.ts",
    "job:daily-topic": "tsx src/jobs/post-daily-topic.ts",
    "job:transfer-daily": "tsx --env-file=.env.local src/jobs/generate-transfer-daily.ts",
    "job:lineup-post": "tsx --env-file=.env.local src/jobs/generate-lineup-post.ts",
    "job:transfer-xi": "tsx --env-file=.env.local src/jobs/generate-transfer-xi.ts",
    "data:football-wages": "tsx --env-file=.env.local scripts/fetch-football-wages.ts",
    "job:news-briefing": "tsx --env-file=.env.local src/jobs/fetch-news-briefing.ts",
    "job:af-odds": "tsx src/jobs/fetch-af-odds.ts",
    "job:backfill": "tsx src/jobs/backfill.ts",
    "job:generate": "tsx src/jobs/generate-articles.ts",
    "job:preview": "tsx src/jobs/generate-previews.ts",
    "job:analysis": "tsx src/jobs/generate-analysis.ts",
    "job:manager-month": "tsx --env-file=.env.local src/jobs/generate-manager-month.ts",
    "job:manager-review": "tsx --env-file=.env.local src/jobs/generate-manager-review.ts",
    "job:tactical": "tsx --env-file=.env.local src/jobs/generate-tactical.ts",
    "job:tod": "tsx src/jobs/generate-team-of-day-article.ts",
    "job:wc-star": "tsx src/jobs/generate-wc-star-report.ts",
    "job:baseball-weekly": "tsx src/jobs/generate-baseball-weekly-review.ts",
    "job:kbo-featured-hitters": "tsx src/jobs/generate-kbo-featured-hitters.ts",
    "job:mlb-weekly-players": "tsx src/jobs/generate-mlb-weekly-players.ts",
    "job:blog-weekly": "tsx src/jobs/generate-blog-weekly.ts",
    "job:mlb-starters": "tsx src/jobs/fetch-mlb-starters.ts",
    "job:nhl-goalies": "tsx src/jobs/fetch-nhl-goalies.ts",
    "job:transactions": "tsx --env-file=.env.local src/jobs/fetch-transactions.ts",
    "job:salaries": "tsx --env-file=.env.local src/jobs/fetch-salaries.ts",
    "scheduler": "tsx src/jobs/scheduler.ts",
    "audit:football-seasons": "tsx --env-file=.env.local scripts/audit-football-seasons.ts",
    "discover:football-seasons": "tsx --env-file=.env.local scripts/discover-football-seasons.ts",
    "verify:football-season": "tsx --env-file=.env.local scripts/verify-football-season.ts",
    "refresh:fifa-rankings": "tsx --env-file=.env.local scripts/refresh-fifa-rankings.ts",
    "backfill:ts-team-mapping": "tsx --env-file=.env.local scripts/backfill-ts-team-mapping.ts",
    "players:match": "tsx scripts/match-player-ids.ts",
    "players:apply": "tsx scripts/apply-player-seed.ts",
    "players:seed": "npm run players:match && npm run players:apply",
    "poisson:test": "tsx scripts/test-poisson-model.ts",
    "preview:kbo": "tsx --env-file=.env.local scripts/preview-now.ts KBO",
    "preview:npb": "tsx --env-file=.env.local scripts/preview-now.ts NPB",
    "preview:mlb": "tsx --env-file=.env.local scripts/preview-now.ts MLB",
    "preview:baseball": "tsx --env-file=.env.local scripts/preview-now.ts ALL",
    "assistant:index": "tsx --env-file=.env.local assistant/index.ts",
    "assistant": "tsx --env-file=.env.local assistant/server.ts",
    "backfill:match-venue": "tsx --env-file=.env.local scripts/backfill-match-venue-id.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "mqtt": "^5.15.1",
    "next": "16.2.6",
    "node-cron": "^4.2.1",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.4",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
