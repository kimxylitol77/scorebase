# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (SQLite dev)
*.db
*.db-journal
prisma/dev.db
prisma/migrations/

# logs
*.log

# chatbot 로컬 전용 파일만 배포 제외 (챗봇 본체는 2026-07-09 배포, AI 는 CHATBOT_AI_ENABLED 로 게이트)
src/lib/chatbot/match-brief.ts
src/lib/chatbot/run-brief.ts

# 로컬 dev 도구 (preview 등)
.claude/

# TheSports 일회성 dump 데이터 (크기 큼, 재실행 가능)
/data/thesports-translations/

# Ollama 번역 제안 출력 (검토 후 team-names.ts/player-names.ts 로 paste)
/data/translations/

# mac-mini 봇 런타임 상태 (각 워커가 로컬 생성)
mac-mini-worker/*.seen.json

# assistant RAG 미니앱 벡터 인덱스 (75MB, 재생성 가능 — 코드는 추적하되 데이터만 제외)
assistant/data/

# SNS 카드 이미지 산출물 (로컬 생성)
sns-cards/

# 일회성 scratch 스크립트·캐시 (_ 접두, 커밋 대상 아님)
scripts/_*-tmp.*
scripts/_cache-*
scripts/_diag-*
