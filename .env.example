# ====================================================
# Scorebase 환경 변수 양식
# ----------------------------------------------------
# 이 파일을 복사해서 .env.local 파일을 만든 뒤 실제 값을 채우세요.
# .env.local 은 git에 커밋되지 않습니다 (.gitignore 등록됨).
# ====================================================

# ===== AI (Google Gemini) =====
# 발급: https://aistudio.google.com/apikey
# 무료 한도: 분당 15 req, 일일 1,500 req (gemini-2.0-flash 기준).
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 모델명은 https://ai.google.dev/gemini-api/docs/models 에서 최신 확인
GEMINI_MODEL=gemini-2.0-flash

# ===== (구) Anthropic Claude — 백업/대체 옵션 =====
# Gemini 대신 Claude 를 쓰려면 src/lib/ai/gemini.ts 를 src/lib/ai/claude.ts 로 교체
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== Sports Data =====
# football-data.org (EPL) - https://www.football-data.org/client/register
# 무료 플랜: 10 req/min, Tier 1 리그 모두 접근 (PL, BL1, PD, SA, FL1, CL 등)
# 결제 카드 등록 X. 키 받으면 EPL 자동 수집이 동작.
FOOTBALL_DATA_KEY=

# api-football (대체 옵션, 무료는 어제 ±1일만 가능해서 사실상 운영 불가)
API_FOOTBALL_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# api-sports Baseball (KBO) - https://api-sports.io/
# 같은 회사이며 보통 동일 키로 모든 스포츠 사용 가능 (Pro 플랜 이상).
# 단일 sport 구독이라면 별도 키 필요할 수 있음 → 요금제 확인.
API_BASEBALL_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MySportsFeeds (NBA / MLB) - https://www.mysportsfeeds.com/
MYSPORTSFEEDS_USER=your_username
MYSPORTSFEEDS_PASS=your_password

# The Odds API — 베팅사이트 odds 통합 (model calibration)
# 무료 500 req/월 / Basic $30/월 20,000 req/월
# 발급: https://the-odds-api.com
ODDS_API_KEY=

# TheSportsDB (KBO) - https://www.thesportsdb.com/
# 비워두면 공용 무료 키 "123" 사용 (30 req/min 제한).
# 본인 키를 받으려면 회원가입 후 발급.
THESPORTSDB_KEY=

# ===== Notification (검수 알림) =====
# Telegram Bot - @BotFather 에서 봇 생성 후 토큰 발급
# Chat ID 확인: 본인 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Database =====
# Neon Postgres 무료 플랜: https://neon.tech (GitHub 로그인 → Create project)
# Connection string 의 ?sslmode=require 가 반드시 붙어야 함.
DATABASE_URL="postgresql://user:pass@host.neon.tech/neondb?sslmode=require"

# ===== Admin (검수 페이지 BasicAuth) =====
# /admin 경로 접근 시 브라우저가 사용자명/비밀번호를 요구합니다.
# 강력한 비밀번호 사용 권장.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# 세션 쿠키 서명용 (32자 이상 무작위 문자열)
ADMIN_SECRET=please-change-this-to-a-random-32-plus-chars-string

# ===== Site =====
SITE_URL=https://scorebase.it.com
SITE_NAME=Scorebase

# ===== Vercel Cron 보호 =====
# 임의 32자 이상 hex 권장. Vercel 환경변수에 등록해두면
# Cron 호출 시 자동으로 Authorization: Bearer <값> 헤더가 송신된다.
CRON_SECRET=please-change-to-random-48-hex-chars
